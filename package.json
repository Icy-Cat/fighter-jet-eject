{
  "name": "fighter-jet-eject",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=esm --outdir=dist --loader:.mp3=file --public-path=./dist --asset-names=[name]-[hash] --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" && tailwindcss -i src/index.css -o dist/main.css --minify"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8" },
  "devDependencies": { "esbuild": "^0.25.0", "@tailwindcss/cli": "4.3.3", "tailwindcss": "4.3.3" }
}
